DB_USER=postgres
DB_HOST=localhost
DB_NAME=UKMH_RMS
DB_PASS=
DB_PORT=5432
PORT=5001

JWT_SECRET=change_this_to_a_secure_random_string

# Comma-separated list of allowed origins (e.g. http://localhost:5175,https://yourdomain.com)
CORS_ORIGIN=http://localhost:5175

# Had kadar per IP (tetingkap 15 minit). Log masuk: hanya percubaan GAGAL dikira.
# Naikkan dalam CI/E2E yang menjalankan banyak ujian dari satu IP.
HAD_LOG_MASUK_IP=30
HAD_API_IP=3000

# Tetapkan jika berada di belakang reverse proxy (cth. 1 untuk nginx dalam Docker)
# supaya had kadar menggunakan IP klien sebenar.
# TRUST_PROXY=1
