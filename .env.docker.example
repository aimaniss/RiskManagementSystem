# Salin ke .env di root repositori untuk `docker compose` (fail .env gitignored).
DB_USER=postgres
DB_NAME=UKMH_RMS
# WAJIB: kata laluan PostgreSQL
DB_PASS=
# WAJIB: rahsia JWT rawak, cth. `openssl rand -hex 32`
JWT_SECRET=
# Port hos & URL aplikasi (untuk CORS)
APP_PORT=8080
APP_URL=http://localhost:8080

# --- VPS dikongsi dengan sistem lain (reverse proxy hos pada 80/443) ---
# Dengar pada localhost sahaja supaya hanya reverse proxy hos boleh capai:
#   APP_PORT=127.0.0.1:8080
# URL awam yang pengguna buka (mesti sama tepat untuk CORS):
#   APP_URL=https://rms.domain-anda.com
# Dua lapisan proxy (hos + nginx kontena):
#   TRUST_PROXY=2
